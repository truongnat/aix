# Copy to .env for Docker Compose and set a strong, unique master password.
# A directly launched server requires KB_MASTER_PASSWORD in its environment.
KB_MASTER_PASSWORD=

# Standalone listener defaults to loopback; Compose overrides this inside its container.
KB_HOST=127.0.0.1
PORT=4000

# Optional host port published by Compose (host interface remains loopback).
KB_PORT=4000

# Optional standalone SQLite/key directory (default ~/.aix/kb).
# KB_DATA_DIR=/path/to/private/data

# Optional CLI memory credential. API keys cannot shut down the service.
# KB_API_KEY=
